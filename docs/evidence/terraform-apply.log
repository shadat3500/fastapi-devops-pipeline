      + user_data                            = <<-EOT
            #!/bin/bash
            # EC2 bootstrap (cloud-init user data), rendered by Terraform.
            # Installs Docker and runs the app with container logs shipped to CloudWatch Logs.
            set -euo pipefail
            exec > >(tee -a /var/log/devops-app-bootstrap.log) 2>&1
            
            echo "bootstrap start: env=staging image=ghcr.io/shadat3500/fastapi-devops-pipeline:1.0.8"
            
            dnf -y update --security
            dnf -y install docker
            systemctl enable --now docker
            
            # State used by later CD deploys (same layout as scripts/deploy.sh).
            install -d -m 0750 /opt/devops-app/staging
            echo "ghcr.io/shadat3500/fastapi-devops-pipeline:1.0.8" | sed 's/.*://' > /opt/devops-app/staging/current_tag
            
            docker network inspect devops-app-net >/dev/null 2>&1 || docker network create devops-app-net
            
            docker pull "ghcr.io/shadat3500/fastapi-devops-pipeline:1.0.8"
            docker rm -f devops-app-staging 2>/dev/null || true
            docker run -d \
              --name devops-app-staging \
              --restart unless-stopped \
              --network devops-app-net \
              -p 8080:8080 \
              -e APP_ENV=staging \
              -e LOG_LEVEL=INFO \
              --read-only --tmpfs /tmp \
              --cap-drop ALL --security-opt no-new-privileges:true \
              --memory 256m --cpus 0.5 \
              --log-driver awslogs \
              --log-opt awslogs-region=us-east-1 \
              --log-opt awslogs-group=/devops-app/staging/app \
              --log-opt awslogs-stream=devops-app-staging \
              "ghcr.io/shadat3500/fastapi-devops-pipeline:1.0.8"
            
            for i in $(seq 1 30); do
              if curl -fsS "http://127.0.0.1:8080/health" >/dev/null; then
                echo "bootstrap done: app healthy after ${i} attempt(s)"
                exit 0
              fi
              sleep 2
            done
            echo "bootstrap: app did not become healthy" >&2
            exit 1
        EOT
