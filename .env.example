# Copy to .env and adjust. .env is git-ignored.
APP_VERSION=1.0.0
APP_ENV=local
LOG_LEVEL=INFO
# Set to true only for demoing dashboards/alerts (exposes GET /error -> 500)
ENABLE_ERROR_ENDPOINT=false

# Grafana admin credentials (used by docker-compose.monitoring.yml)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me-to-a-strong-password
