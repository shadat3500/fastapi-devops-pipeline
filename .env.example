# Copy to .env and adjust. .env is git-ignored.

# ---- App (docker-compose.yml) ----
APP_VERSION=1.0.0
APP_ENV=local
LOG_LEVEL=INFO
# Host port for the app (container always listens on 8080 internally)
APP_HOST_PORT=8080
# Set to true only for demoing dashboards/alerts (exposes GET /error -> 500)
ENABLE_ERROR_ENDPOINT=false

# ---- Monitoring (docker-compose.monitoring.yml) ----
# Grafana admin credentials. The password is REQUIRED (compose refuses to start without it).
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=
# Grafana is the only published port. Bound to localhost by default; use an SSH tunnel
# from your laptop: ssh -L 3000:127.0.0.1:3000 user@server
GRAFANA_BIND=127.0.0.1
GRAFANA_HOST_PORT=3000
# Which app instances Prometheus scrapes: local (compose app) | vps (CD-deployed staging+production)
PROM_TARGETS=local
PROMETHEUS_RETENTION=15d
# Private bridge for the monitoring stack; node-exporter listens on its gateway IP.
# If you change these, also change the node target in monitoring/prometheus/prometheus.yml.
MONITORING_SUBNET=172.31.250.0/24
MONITORING_GATEWAY=172.31.250.1
