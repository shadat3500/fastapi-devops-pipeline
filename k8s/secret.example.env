# Template for the devops-app-secret Secret. NEVER commit real values.
# Copy to k8s/secret.env (git-ignored) and create the Secret from it:
#   kubectl -n devops-staging create secret generic devops-app-secret \
#     --from-env-file=k8s/secret.env --dry-run=client -o yaml | kubectl apply -f -
# The app currently has no real secrets; this demonstrates the delivery path that a
# DB password or API key would take. Production: External Secrets Operator + AWS
# Secrets Manager (see README "Kubernetes on EKS").
API_TOKEN=replace-me
